# Cloudflare API Token (Requiere permisos Zone.DNS:Edit y opcionalmente Zone.Zone:Read para auto-detección)
CF_API_TOKEN="tu_token_de_api_cloudflare_aqui"

# Cloudflare Zone ID (Opcional si tu Token tiene permisos de lectura de zona)
# Puedes especificar un ID, varios separados por espacios "id1 id2", o dejarlo en blanco para auto-detectar según el dominio.
CF_ZONE_ID="mi_zone_id_"

# Nombres de dominio o subdominios a conmutar (separados por espacios o comas)
# Soporta múltiples dominios de diferentes zonas (ej. dominio.com y dominio.es)
CF_DOMAINS="dominio.com www.dominio.com dominio.es www.dominio.es"

# Comando opcional a ejecutar tras la conmutación (ej: reload nginx, docker compose, etc.)
# Dejar en blanco si no se requiere.
RELOAD_SERVICE=""
